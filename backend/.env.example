# Application Settings
PROJECT_NAME="AI Learning Assistant API"

# development | production
#
# This one value decides whether the API publishes its own documentation.
# In production, /api/v1/docs, /api/v1/redoc and /api/v1/openapi.json all return
# 404: the schema is a complete map of every route and model, which is helpful
# to a developer and a gift to an attacker on a public host. Leave it as
# "development" everywhere else so the Swagger UI stays usable.
ENVIRONMENT="development"

# DEBUG is FastAPI's exception-detail switch only. It is deliberately NOT wired
# to SQL logging -- see SQL_ECHO below.
DEBUG=False

# SQL_ECHO=true makes SQLAlchemy log every statement *and its bound
# parameters*. On this schema that means password hashes, JWT subjects, quiz
# answers, document text and embedding vectors end up in the application log.
# Leave it off unless you are debugging a single query, and never on a shared
# or deployed instance.
SQL_ECHO=False

# Database Settings (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_learning_assistant
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_learning_assistant"

# AI / LLM Configuration
#
# GEMINI_API_KEY must be left exactly as the placeholder below (or empty) to run
# fully offline: every generator and the tutor detect the placeholder and fall
# back to a deterministic path instead of calling the API.
GEMINI_API_KEY="your_gemini_api_key_here"

# Must be a real, currently-served Gemini model id. A wrong id fails every
# generative request, and because the failure is absorbed by the offline
# fallback it is invisible -- the API keeps returning 200s.
GEMINI_QA_MODEL="gemini-3.8-flash"

# Embedding model and vector width. The width is baked into the database schema
# (document_chunks.embedding is Vector(768)); changing it requires a migration
# and a full re-embedding pass over every stored chunk.
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"
EMBEDDING_DIMENSIONS=768

# Observability
# LOG_LEVEL accepts a standard level name (DEBUG/INFO/WARNING/ERROR/CRITICAL).
# LOG_JSON=true emits one JSON object per line, for log shippers.
LOG_LEVEL="INFO"
LOG_JSON=False

# Security (JWT)
#
# SECRET_KEY is REQUIRED and has no default on purpose. JWTs are signed
# symmetrically, so anyone who knows this value can mint a valid access token
# for any user id and take over that account. The repository therefore ships no
# usable value -- leaving this empty makes the app refuse to start with a clear
# error instead of signing tokens with something guessable.
#
# Generate your own (do not commit it, do not reuse it across environments):
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM="HS256"

# Session lifetime.
#
# The access token used to live for a full day, so anything that captured one --
# a shared machine, a proxy log, a browser extension -- stayed usable for up to
# 24 hours with no way to withdraw it. It is now short-lived, and the session
# survives past it via an opaque refresh token that the server stores only as a
# SHA-256 digest and can revoke individually (logout) or all at once (password
# change, which also bumps users.token_version).
ACCESS_TOKEN_EXPIRE_MINUTES=15
# How long a signed-in browser stays signed in without asking for credentials
# again. Lowering this is the blunt way to shorten the exposure of a stolen
# device; it is not a substitute for revocation, which already works.
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth cookies.
#
# The access and refresh tokens are delivered in HttpOnly cookies so application
# JavaScript never holds a credential (see app/core/auth_cookies.py).
#
# AUTH_COOKIE_SECURE is forced on when ENVIRONMENT=production: without `Secure`
# a cookie is sent over plaintext HTTP and is captured in transit. It only stays
# False in development, where the API is on http://localhost.
AUTH_COOKIE_SECURE=False
# lax or strict keeps the cookie off cross-site requests, which is what makes the
# double-submit CSRF token a second line of defence rather than the only one.
# Use "none" only when the frontend and API are on different *sites* (not just
# different ports) -- it requires AUTH_COOKIE_SECURE=true or browsers drop it.
AUTH_COOKIE_SAMESITE="lax"
# Empty means host-only, which is the tightest option. Set it only to share a
# session across subdomains of one parent domain.
AUTH_COOKIE_DOMAIN=""
# Double-submit CSRF protection for cookie-authenticated writes. Turn this off
# only if something in front of the API already provides equivalent protection.
CSRF_PROTECTION_ENABLED=True

# PBKDF2 work factor for password hashing. The passlib default of 29,000 is
# well under current OWASP guidance. The round count is stored inside each
# hash, so raising this does not invalidate existing passwords: they keep
# verifying and are silently rehashed with the new factor on the next login.
PBKDF2_ROUNDS=600000

# Rate limiting (in-process sliding window -- see app/core/rate_limit.py).
#
# Set RATE_LIMIT_ENABLED=False in a local .env if repeated test/seed requests
# are getting 429s. It should stay enabled everywhere else.
#
# The counters live in the API process's memory, so running more than one
# uvicorn worker multiplies the effective limit by the worker count.
RATE_LIMIT_ENABLED=True
# Login: per (client address, submitted email). Sized to allow a handful of
# genuine retries while stopping credential stuffing.
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# Registration: per client address, over a longer window. Stops automated
# free-account farming.
RATE_LIMIT_REGISTER_ATTEMPTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=300
# Generative/RAG/quiz/flashcard/study-plan endpoints: per authenticated user,
# per minute. This is the budget that bounds Gemini spend.
RATE_LIMIT_GENERATIVE_ATTEMPTS=30
RATE_LIMIT_GENERATIVE_WINDOW_SECONDS=60
# Document upload + reprocess: per authenticated user, per hour. Each upload
# runs the full chunk-and-embed pipeline in the background.
RATE_LIMIT_UPLOAD_ATTEMPTS=10
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600

# CORS Origins (JSON formatted array string or comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
